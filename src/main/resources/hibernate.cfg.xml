<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 5.3//EN"
        "http://hibernate.org/dtd/hibernate-configuration-5.3.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- JDBC connection -->
        <property name="hibernate.connection.driver_class">org.mariadb.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mariadb://127.0.0.1:3307/bookstore</property>
        <property name="hibernate.connection.username">dgtic</property>
        <property name="hibernate.connection.password">dgtic1234</property>

        <!-- Hibernate dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MariaDBDialect</property>

        <!-- Automatic schema update -->
<!--        <property name="hibernate.hbm2ddl.auto">update</property>-->

        <!-- Debug -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Entity mappings (XML or annotations) -->
        <mapping resource="mapping/book.hbm.xml"/>

    </session-factory>
</hibernate-configuration>
